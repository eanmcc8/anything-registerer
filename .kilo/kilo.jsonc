{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "deny",
      "npm *": "ask",
      "rm *": "deny",
      "grep *": "ask",
      "**/*.py": "ask",
      "*.py": "allow"
    },
    "edit": {
      "*": "ask"
    },
    "external_directory": {
      "**/": "ask"
    }
  },
  "snapshot": false
}